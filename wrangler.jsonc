{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-web",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "preview_urls": true,
  "main": "./cloudflare/worker.mjs",
  "build": {
    "command": "node scripts/assert-cloudflare-main-release.mjs && npm run build:cloudflare"
  },
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/plugins/*",
      "/assets/*",
      "/__hivemind/*",
      "/manifest.webmanifest",
      "/hivemind/app/overview",
      "/hivemind/app/overview/*",
      "/hivemind/*"
    ]
  },
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "2e89fbd3-7496-459b-a507-f1017d444dd9"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "LANDING_MOBILE_V2": "true",
    "RUNNER_ORIGIN": "https://harness-chat-origin.singulancelabs.com"
  },
  "routes": [
    {
      "pattern": "singulancelabs.com",
      "custom_domain": true
    },
    {
      "pattern": "next.singulancelabs.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.hivemind.singulancelabs.com",
      "custom_domain": true
    },
    {
      "pattern": "icarus.singulancelabs.com",
      "custom_domain": true
    }
  ]
}
