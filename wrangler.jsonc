{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-web",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "preview_urls": true,
  "main": "./cloudflare/worker.mjs",
  "build": {
    "command": "node scripts/assert-cloudflare-main-release.mjs && npm run build:cloudflare"
  },
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "2e89fbd3-7496-459b-a507-f1017d444dd9"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "LANDING_MOBILE_V2": "true",
    "RUNNER_ORIGIN": "https://harness-chat-origin.singulancelabs.com",
    "RUNTIME_RUNNER_PUBLIC_ORIGIN": "https://runtime-runner.singulancelabs.com",
    "RUNTIME_RUNNER_ORIGIN": "https://runtime-runner-origin.singulancelabs.com",
    "DEV_COMMUNITY_ADMINS": "support@singulancelabs.com"
  },
  "routes": [
    {
      "pattern": "getruntime.singulancelabs.com",
      "custom_domain": true
    },
    {
      "pattern": "runtime.singulancelabs.com",
      "custom_domain": true
    },
    {
      "pattern": "singulancelabs.com",
      "custom_domain": true
    },
    {
      "pattern": "next.singulancelabs.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.hivemind.singulancelabs.com",
      "custom_domain": true
    },
    {
      "pattern": "amar.singulancelabs.com",
      "custom_domain": true
    },
    {
      "pattern": "icarus.singulancelabs.com",
      "custom_domain": true
    },
    {
      "pattern": "pitch.singulancelabs.com",
      "custom_domain": true
    },
    {
      "pattern": "runtime-runner.singulancelabs.com",
      "custom_domain": true
    },
    {
      "pattern": "dev.singulancelabs.com",
      "custom_domain": true
    }
  ],
  "send_email": [
    { "name": "BUG_REPORT_EMAIL", "destination_address": "support@singulancelabs.com" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COMPOSIO_ACCOUNTS", "class_name": "ComposioAccount" },
      {
        "name": "ACCOUNT_MODE_ACCESS",
        "class_name": "AccountModeAccess"
      },
      { "name": "DEV_COMMUNITY", "class_name": "DevCommunity" }
    ]
  },
  "migrations": [
    {
      "tag": "account-mode-access-v1",
      "new_sqlite_classes": [
        "AccountModeAccess"
      ]
    },
    { "tag": "composio-account-v1", "new_sqlite_classes": ["ComposioAccount"] },
    { "tag": "dev-community-v1", "new_sqlite_classes": ["DevCommunity"] }
  ]
}
