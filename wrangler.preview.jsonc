{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-web-preview",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "preview_urls": true,
  "main": "./cloudflare/worker.mjs",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "next.preview.singulancelabs.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
