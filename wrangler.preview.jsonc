{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-web-preview",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "preview_urls": true,
  "main": "./cloudflare/worker.mjs",
  "services": [
    {
      "binding": "HARNESS_CHAT",
      "service": "hivemind-harness-chat-preview"
    }
  ],
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "2e89fbd3-7496-459b-a507-f1017d444dd9"
    }
  ],
  "vars": {
    "ENVIRONMENT": "preview",
    "RUNNER_ORIGIN": "https://harness-origin.preview.singulancelabs.com"
  },
  "routes": [
    {
      "pattern": "next.preview.singulancelabs.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
