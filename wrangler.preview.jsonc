{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-web-preview",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "preview_urls": true,
  "main": "./cloudflare/worker.mjs",
  "services": [
    {
      "binding": "HARNESS_CHAT",
      "service": "hivemind-harness-chat-preview"
    }
  ],
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/plugins/*", "/assets/*", "/__hivemind/*", "/hivemind/app/overview", "/hivemind/app/overview/*"]
  },
  "routes": [
    {
      "pattern": "next.preview.singulancelabs.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
