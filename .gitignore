# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/.next
/*.tsbuildinfo
/.wrangler
/.wrangler-*

# misc
.DS_Store
# Local env files hold secrets and are never committed. The tracked public
# .env.development/.env.production stay tracked; new ones must be force-added.
.env
.env-*
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
.vercel
# ICARUS Harness runtime state (local, never commit)
.icarus/runtime/
.icarus-graph/

# Exported immutable native code is a release artifact, not source.
/public/runtime-native/
