# The SPA shell must be revalidated for every visit so a deploy cannot leave a
# user on an obsolete runtime. CRA emits content-hashed assets under /static,
# which are safe to cache indefinitely.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/static/*
  Cache-Control: public, max-age=31536000, immutable

# Public meeting authorization is deliberately isolated from analytics,
# embeds, and referrer propagation. It needs only the first-party SPA and API.
/hivemind/meeting-consent*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.singulancelabs.com https://preview-api.singulancelabs.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# Hero/marketing images under public/ are re-encoded in place (same filename,
# new bytes) rather than content-hashed, so no immutable — a day of edge cache
# plus a week of stale-while-revalidate keeps repeat visits fast without
# risking a stuck stale image after a re-export.
/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.avif
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
