# The SPA shell must be revalidated for every visit so a deploy cannot leave a
# user on an obsolete runtime. CRA emits content-hashed assets under /static,
# which are safe to cache indefinitely.
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/app-versions.json
  Cache-Control: no-cache, no-store, must-revalidate

/static/*
  Cache-Control: public, max-age=31536000, immutable

# Locale bundles are not content-hashed: keep a short fresh window and let
# stale copies serve while a background revalidation fetches the new bytes.
/locales/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800

# Hero/marketing images under public/ are re-encoded in place (same filename,
# new bytes) rather than content-hashed, so no immutable — a day of edge cache
# plus a week of stale-while-revalidate keeps repeat visits fast without
# risking a stuck stale image after a re-export.
/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.avif
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
